<div id="<%= dom_id task %>">
  <div>
    <strong>Title:</strong>
    <%= task.title %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= task.description %>
  </div>

  <div>
    <strong>Has time:</strong>
    <%= task.has_time %>
  </div>

  <div>
    <strong>Start time:</strong>
    <%= task.start_time %>
  </div>

  <div>
    <strong>End time:</strong>
    <%= task.end_time %>
  </div>

  <div>
    <strong>Has duration:</strong>
    <%= task.has_duration %>
  </div>

  <div>
    <strong>Duration:</strong>
    <%= task.duration %>
  </div>

</div>
